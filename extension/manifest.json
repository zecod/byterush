{
  "manifest_version": 3,
  "name": "Byterush — download catcher",
  "short_name": "Byterush",
  "version": "0.3.0",
  "description": "Hands your browser downloads to the Byterush app: parallel connections, resume, and the same session cookies so protected sites keep working.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "webRequest",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Byterush",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "externally_connectable": {
    "matches": [
      "https://zecod.github.io/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
